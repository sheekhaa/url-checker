{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",

    "rootDir": "./src",
    "outDir": "./dist",

    "strict": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,

    "skipLibCheck": true,
    "sourceMap": true,

    "noEmit": false,

    "resolveJsonModule": true,

    "types": ["node"]
  },
  "include": ["src"]
}
